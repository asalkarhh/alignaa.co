# Alignaa D2C Website Environment Variables
# Copy this file to .env or .env.local to configure hosted form delivery

# Hosted form endpoint URL (e.g. https://formspree.io/f/your_form_id or your secure API endpoint)
# If left empty, the site runs in honest preview mode: submissions are logged locally with an informative notice
VITE_FORM_ENDPOINT=

# Configured destination inbox for Alignaa operations team (displayed in status notifications)
VITE_OWNER_INBOX=support@alignaa.co

# Show illustrative comparison table for design preview review (set to 'false' for production launch)
VITE_ENABLE_ILLUSTRATIVE_COMPARISON=true

# Production indexing toggle (set to 'true' when authorized for public launch)
VITE_ENABLE_PRODUCTION_INDEXING=false

